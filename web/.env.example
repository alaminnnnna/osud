# Medora unified app — environment (copy to .env.local for dev)
# Phase 4: ONE Next.js application serves the frontend AND /api/v1, backed by
# the project's own EMBEDDED SQLite database — no rented database service.

# Self-contained database file. Optional: defaults to <repo>/data/medora.sqlite.
# On Render, point this at the persistent-disk mount (see DEPLOYMENT_RENDER.md).
# MEDORA_DB_PATH=data/medora.sqlite

# Public site origin (canonical URLs, metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin protection (middleware Basic auth + /api/v1/admin/*). Leave empty to disable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=medora-admin-local

# Secure scraper ingestion (bearer token). Leave empty to disable /api/v1/ingest/*.
INGEST_TOKEN=local-test-token

# API behaviour (same defaults as the audited platform API)
ACCESS_CONTROL_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
CACHE_LIST_SECONDS=60
