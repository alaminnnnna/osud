# Medora unified app — environment (copy to .env.local for dev)
# Phase 4: this ONE application serves the frontend AND /api/v1.
# The Express platform server is superseded; DATABASE_URL lives here now.

# PostgreSQL (external, persistent). On serverless platforms use the POOLED
# connection string (PgBouncer transaction mode) and keep DB_POOL_MAX small.
DATABASE_URL=postgres://medora:medora@localhost:5432/medora
DB_POOL_MAX=10

# Public site origin (canonical URLs, metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin protection (middleware Basic auth + /api/v1/admin/*). Leave empty to disable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=medora-admin-local

# Secure scraper ingestion (bearer token). Leave empty to disable /api/v1/ingest/*.
INGEST_TOKEN=local-test-token

# API behaviour (same defaults as the audited platform API)
ACCESS_CONTROL_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
CACHE_LIST_SECONDS=60
