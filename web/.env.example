# Medora web — environment (copy to .env.local for dev)
# Backend API base (the platform Express server). Never expose DB credentials here.
BACKEND_URL=http://localhost:4000

# Public site origin (canonical URLs, metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin protection (middleware Basic auth). Leave empty to disable /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=medora-admin-local
