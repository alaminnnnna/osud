{
  "name": "medora-web",
  "version": "4.0.0",
  "private": true,
  "description": "Medora unified application \u2014 Next.js App Router serving the frontend AND /api/v1 on top of the embedded SQLite database (no external database service).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:init": "node scripts/migrate.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "import:data": "tsx scripts/import-data.mts",
    "import:resume": "tsx scripts/import-data.mts --resume",
    "import:dry-run": "tsx scripts/import-data.mts --dry-run"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.469.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}