# Medora platform — environment variables (copy to .env for local dev).
# NEVER commit real credentials. Frontend code never receives these values.

# --- Database (required) ---
# Local dev (docker-compose up):  postgres://medora:medora@localhost:5432/medora
# Render (internal):              <internal database url>
# Render/Vercel (external/pooled for serverless): use the POOLED url on Vercel.
DATABASE_URL=postgres://medora:medora@localhost:5432/medora

# --- Source dataset (importer input) ---
DATA_DIR=../data

# --- API server ---
PORT=4000
# CORS: '*' for local dev; set to your frontend origin(s), comma-separated, in production.
ACCESS_CONTROL_ORIGIN=*
# Fixed-window rate limit per IP (requests per minute). 0 disables.
RATE_LIMIT_PER_MINUTE=120
# Cache-Control for public list endpoints (seconds).
CACHE_LIST_SECONDS=60

# --- Admin dashboard (/admin) ---
# Leave empty to DISABLE admin routes entirely (recommended unless needed).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Scraper ingestion (Phase 9) ---
# Bearer token required by POST /api/v1/ingest/*. Generate: openssl rand -hex 32
INGEST_TOKEN=
